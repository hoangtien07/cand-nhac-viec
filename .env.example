# Copy to .env and fill in. Never commit .env. Generate values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=pocketops
POSTGRES_USER=pocketops
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443
DJANGO_HSTS_SECONDS=3600
DEMO_HTTPS_PORT=8443
# Optional: one shared demo password chosen by the operator for seed_demo.
# Leave empty → random password per account written to var/demo_credentials.txt (0600).
DEMO_SEED_PASSWORD=
